# =============================================================================
# USER-EDITABLE SETTINGS
# Change these values to match your WADMP environment and selected location API.
# LOCATION_PROVIDER supports: opencell, here
# =============================================================================

DMP_USERNAME="your-wadmp-username"
DMP_PASSWORD="your-wadmp-password"
DMP_COMPANY_ID="your_company_ID"
DMP_LONG_OPERATION_TIMEOUT_SECONDS="120"
OUTPUT_RETENTION_DAYS="14"
LOG_RETENTION_DAYS="14"
RUN_INTERVAL_HOURS="0"

# Select your desired provider ("opencell" or "here")
LOCATION_PROVIDER="here"

# OpenCell / Unwired Labs settings
# Fill these if LOCATION_PROVIDER="opencell"
OPENCELL_TOKEN="your-opencell-token"
OPENCELL_API_URL="https://eu1.unwiredlabs.com/v2/process.php"

# HERE Positioning settings
# Fill these if LOCATION_PROVIDER="here"
HERE_API_KEY="your-here-api-key"
HERE_API_URL="https://pos.ls.hereapi.com/positioning/v1/locate"
HERE_FALLBACK="area"

# =============================================================================
# USUALLY DO NOT CHANGE
# Change these only if your WADMP environment uses different field names
# or the vendor explicitly tells you to change them.
# =============================================================================

DMP_PLMN_FIELD="MoPlmn"
DMP_CELL_FIELD="MoCell"
DMP_MAC_ADDRESS_FIELD="MacAddress"
DMP_GPS_LAT_FIELD="GpsLat"
DMP_GPS_LON_FIELD="GpsLon"
DMP_GPS_ALT_FIELD="GpsAlt"
DMP_ONLINE_FIELD="Online"
DMP_ONLINE_VALUE="1"
DMP_MNC_LENGTH="2"
DMP_BATCH_PAGE_SIZE="100"
LOCATION_CACHE_PATH="location_cache.json"

# =============================================================================
# DO NOT CHANGE
# Keep these values as they are unless WADMP support or the developers
# explicitly instruct you otherwise.
# =============================================================================

DMP_TOKEN_URL="https://gateway.wadmp3.com/public/auth/connect/token"
DMP_API_BASE_URL="https://gateway.wadmp3.com/api"
DMP_LONG_OPERATION_PATH="/long-operations/{operation_id}"
DMP_LONG_OPERATION_POLL_SECONDS="2"
REQUEST_TIMEOUT_SECONDS="20"
VERIFY_TLS="true"
